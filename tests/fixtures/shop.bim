        "toColumn": "Date"
      },
      {
        "name": "0a1b2c3d-0000-0000-0000-000000000003",
        "isActive": false,
        "fromTable": "Sales",
        "fromColumn": "Ship Date",
        "toTable": "Dates",
        "toColumn": "Date"
      }
    ],
