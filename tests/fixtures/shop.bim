{
  "name": "Shop",
  "compatibilityLevel": 1567,
  "model": {
    "tables": [
      {
        "name": "Product",
        "description": "One row per product.",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
