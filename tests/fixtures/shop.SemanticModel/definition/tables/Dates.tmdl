table Dates
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column MonthNo
		dataType: int64
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [MonthNo]

	column Month
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: MonthNo

	hierarchy Calendar
		level Year
			column: Year

		level Month
			column: Month

	partition Dates = calculated
		mode: import
		source = ```
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2024, 3, 31 ) ),
				    "Year", YEAR ( [Date] ),
				    "MonthNo", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm" )
				)
				```
